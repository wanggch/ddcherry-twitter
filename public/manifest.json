{
  "manifest_version": 3,
  "name": "X Post Saver",
  "version": "1.0.0",
  "description": "Save X (Twitter) posts to your backend API",
  "permissions": ["tabs", "storage", "contextMenus", "activeTab", "scripting", "notifications", "clipboardWrite"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://127.0.0.1:27123/*", "http://127.0.0.1:18787/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://x.com/i/article/*",
        "https://twitter.com/i/article/*"
      ],
      "js": ["content-script.js"]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
